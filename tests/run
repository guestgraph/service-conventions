#!/bin/sh
# tests/run — the sync check and the service check against fixtures, offline: the source is
# this repository itself, through SERVICE_CONVENTIONS_SOURCE. Exit 1 on the first failure.
set -eu
cd "$(dirname "$0")/.."
ROOT=$(pwd)
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
fail() { echo "✗ $1" >&2; exit 1; }
pass() { echo "✓ $1"; }

# A service that vendors the Spring stack from this checkout.
service() {
  rm -rf "$TMP/$1"; cp -R tests/fixtures/service "$TMP/$1"
  (cd "$TMP/$1" && SERVICE_CONVENTIONS_SOURCE="$ROOT" sh "$ROOT/spring/service-conventions-sync" sync > /dev/null)
}

# --- the sync check (user story 1) ---
service same
(cd "$TMP/same" && SERVICE_CONVENTIONS_SOURCE="$ROOT" sh service-conventions/service-conventions-sync check > /dev/null) \
  || fail "a copy equal to the pin fails the sync check"
[ -f "$TMP/same/.github/workflows/verify.yml" ] || fail "the sync did not write the workflow"
[ -f "$TMP/same/src/test/java/ServiceRulesTest.java" ] || fail "the sync did not write the rules test"
grep -q '<!-- service-conventions · v' "$TMP/same/AGENTS.md" || fail "the sync did not write the agent block"
awk '/<!-- end conventions -->/{c=NR} /<!-- service-conventions · /{s=NR} END{exit !(c && s && s>c)}' "$TMP/same/AGENTS.md" \
  || fail "the service block does not follow the family's block"
pass "a copy equal to the pin passes the sync check, with the workflow, the test and the block written"

service drift
printf 'x' >> "$TMP/drift/service-conventions/pmd-ruleset.xml"
out=$(cd "$TMP/drift" && SERVICE_CONVENTIONS_SOURCE="$ROOT" sh service-conventions/service-conventions-sync check 2>&1 || true)
echo "$out" | grep -q '✗ service-conventions: service-conventions/pmd-ruleset.xml differs from' \
  || fail "one character of drift did not fail naming the file: $out"
(cd "$TMP/drift" && SERVICE_CONVENTIONS_SOURCE="$ROOT" sh service-conventions/service-conventions-sync check > /dev/null 2>&1) \
  && fail "drift exited 0" || true
pass "one character of drift fails the sync check naming the file"

service runtimedrift
printf 'x' >> "$TMP/runtimedrift/src/main/java/io/guestgraph/service/Problems.java"
out=$(cd "$TMP/runtimedrift" && SERVICE_CONVENTIONS_SOURCE="$ROOT" sh service-conventions/service-conventions-sync check 2>&1 || true)
echo "$out" | grep -q '✗ service-conventions: src/main/java/io/guestgraph/service/Problems.java differs from' \
  || fail "a drifted runtime class did not fail naming it: $out"
pass "a drifted runtime class fails the sync check naming it"

service missing
rm "$TMP/missing/src/test/java/ServiceRulesTest.java"
out=$(cd "$TMP/missing" && SERVICE_CONVENTIONS_SOURCE="$ROOT" sh service-conventions/service-conventions-sync check 2>&1 || true)
echo "$out" | grep -q '✗ service-conventions: src/test/java/ServiceRulesTest.java differs from' \
  || fail "a missing vendored file did not fail naming it: $out"
pass "a missing vendored file fails the sync check naming it"

# --- the service check (user story 2) ---
# A passing service: the fixture, vendored from this checkout, with every item in place.
check() { (cd "$1" && SERVICE_CONVENTIONS_SOURCE="$ROOT" sh "$ROOT/spring/service-conventions-check" 2>&1); }
passing() {
  rm -rf "$TMP/$1"; cp -R tests/fixtures/passing "$TMP/$1"
  (cd "$TMP/$1" && SERVICE_CONVENTIONS_SOURCE="$ROOT" sh "$ROOT/spring/service-conventions-sync" sync > /dev/null)
}
passing ok
out=$(check "$TMP/ok") || fail "a service with every item fails the service check: $out"
[ -z "$out" ] || fail "a passing service check printed: $out"
pass "a service with every item passes the service check without a word"

# One fixture per item, that item removed, each failing with its line.
expect_missing() {  # <fixture name> <item> <shell that removes the item, run inside the fixture>
  passing "$1"; (cd "$TMP/$1" && sh -c "$3")
  out=$(check "$TMP/$1" || true)
  echo "$out" | grep -q "^✗ service-conventions: $2: " || fail "removing the $2 did not fail naming it: $out"
  (check "$TMP/$1" > /dev/null 2>&1) && fail "removing the $2 exited 0" || true
  pass "removing the $2 fails the service check naming it"
}
expect_missing parent parent "sed -i.bak 's|<version>0.5.0</version>|<version>0.1.0</version>|' pom.xml"
expect_missing root root "mkdir -p src/main/java/io/guestgraph/other && touch src/main/java/io/guestgraph/other/Other.java"
expect_missing api api "mkdir -p src/main/java/io/guestgraph/probe/ops && mv src/main/java/io/guestgraph/probe/api/ProbeController.java src/main/java/io/guestgraph/probe/ops/"
expect_missing apidoc api-document "rm src/main/resources/api/openapi.yaml"
expect_missing apihand api-document "sed -i.bak '1d' src/main/resources/api/openapi.yaml"
expect_missing apiunlisted api-document "printf 'openapi: 3.1.0\n' > src/main/resources/api/unlisted.yaml"
expect_missing apisources api-document "rm src/main/resources/api/sources.json"
expect_missing health health "sed -i.bak 's/include: health/include: health,env/' src/main/resources/application.yaml"
expect_missing problem problem-details "sed -i.bak 's/enabled: true/enabled: false/' src/main/resources/application.yaml"
expect_missing cap request-cap "sed -i.bak '/max-request-bytes/d' src/main/resources/application.yaml"
expect_missing schema schema "sed -i.bak 's/default-schema: .*/default-schema: probe/' src/main/resources/application.yaml"
expect_missing diagram diagram "rm docs/er-schema.mmd"
expect_missing local local-profile "sed -i.bak '/^---/,\$d' src/main/resources/application.yaml"
expect_missing readme readme "sed -i.bak '/create schema/d' README.md"
expect_missing agents agents "sed -i.bak '/service-conventions/d' AGENTS.md"

# --- the scaffold (user story 3) ---
rm -rf "$TMP/probe"
SERVICE_CONVENTIONS_SOURCE="$ROOT" CONVENTIONS_SOURCE="$ROOT" sh new-service spring probe "$TMP/probe" > /dev/null \
  || fail "new-service did not write a service"
(cd "$TMP/probe" && SERVICE_CONVENTIONS_SOURCE="$ROOT" sh service-conventions/service-conventions-sync check > /dev/null) \
  || fail "the scaffolded service fails the sync check"
out=$(cd "$TMP/probe" && SERVICE_CONVENTIONS_SOURCE="$ROOT" sh service-conventions/service-conventions-check 2>&1) \
  || fail "the scaffolded service fails the service check: $out"
(cd "$TMP/probe" && CONVENTIONS_SOURCE="$ROOT" sh conventions/conventions-sync check > /dev/null) \
  || fail "the scaffolded service fails the family's sync check"
for f in pom.xml compose.yaml CLAUDE.md LICENSE README.md AGENTS.md src/main/java/io/guestgraph/probe/ProbeApplication.java src/main/resources/db/migration/V1__init.sql; do
  [ -f "$TMP/probe/$f" ] || fail "the scaffolded service lacks $f"
done
pass "a scaffolded service passes both checks and the family's on its first run"

echo "all pass"

# The shared runtime, compiled and tested where it is written.
(cd spring/runtime && ./mvnw -q verify) || fail "the runtime module does not verify"
pass "the runtime module verifies"
