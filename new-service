#!/bin/sh
# new-service — write the skeleton of a guestgraph service of one stack, so that it passes the
# family's sync check, the stack's sync check and the service check on its first run.
#
#   sh new-service <stack> <name> [directory]      directory defaults to ./<name>
#
# The files a service vendors come from this repository at the release this checkout is at,
# through SERVICE_CONVENTIONS_SOURCE (a base URL or a local directory holding the stack's
# directory), and the family's conventions from robertblust/conventions at the release this
# repository pins, through CONVENTIONS_SOURCE. The result is a service, not a template: its
# name, root package and schema are derived from <name> the way SERVICE.md says.
set -eu

[ $# -ge 2 ] || { echo "usage: sh new-service <stack> <name> [directory]" >&2; exit 2; }
STACK=$1; NAME=$2; DIR=${3:-./$NAME}
HERE=$(cd "$(dirname "$0")" && pwd)
[ -d "$HERE/$STACK" ] || { echo "new-service: no stack $STACK here" >&2; exit 1; }
[ "$STACK" = spring ] || { echo "new-service: only the spring stack has a skeleton yet" >&2; exit 1; }
[ ! -e "$DIR" ] || { echo "new-service: $DIR exists" >&2; exit 1; }

TAG=$(sed -n 's/^<!-- service-conventions · \(v[^ ]*\) -->$/\1/p' "$HERE/$STACK/AGENTS.md" | head -1)
FAMILY_REPO=$(sed -n 's/.*"repo" *: *"\([^"]*\)".*/\1/p' "$HERE/conventions.json" | head -1)
FAMILY_TAG=$(sed -n 's/.*"tag" *: *"\([^"]*\)".*/\1/p' "$HERE/conventions.json" | head -1)
ROOT=io.guestgraph.$(echo "$NAME" | tr '-' '.')
ROOTPATH=$(echo "$ROOT" | tr . /)
SCHEMA=$(echo "$NAME" | tr '-' '_')
CLASS=$(echo "$NAME" | awk -F- '{ for (i = 1; i <= NF; i++) printf "%s%s", toupper(substr($i, 1, 1)), substr($i, 2) }')

mkdir -p "$DIR" && cd "$DIR"
mkdir -p "src/main/java/$ROOTPATH/api" src/main/resources/db/migration src/test/java api docs .github/workflows

cat > service-conventions.json <<EOF
{ "repo": "guestgraph/service-conventions", "tag": "$TAG", "stack": "$STACK", "root": "$ROOT", "scope": "tenantId", "schema": "$SCHEMA", "jdbcClientAllowed": [] }
EOF
cat > conventions.json <<EOF
{ "repo": "$FAMILY_REPO", "tag": "$FAMILY_TAG", "exclude": ["target"] }
EOF

# The family's conventions first, so the family's block leads the agent file.
mkdir -p conventions
FSRC=${CONVENTIONS_SOURCE:-https://raw.githubusercontent.com/$FAMILY_REPO/$FAMILY_TAG}
case "$FSRC" in
  http://*|https://*) curl -fsSL "$FSRC/conventions/conventions-sync" -o conventions/conventions-sync ;;
  *) cp "$FSRC/conventions/conventions-sync" conventions/conventions-sync ;;
esac
cat > AGENTS.md <<EOF
# $NAME — working conventions

What this service is for is one paragraph in its README; this file says how to build and check.
It is specified in the engine repository under \`specs/\`, and that specification is the owner of
every decision here.

## Build and verify

\`\`\`bash
./mvnw verify                                        # tests (Testcontainers, needs Docker), the rules, PMD, Spotless
./mvnw spotless:apply                                # fix formatting
sh service-conventions/regen-er                      # after a migration; CI checks drift
sh service-conventions/service-conventions-check     # what of the list the service lacks
sh conventions/conventions-check                     # the prose
\`\`\`

## Checks

Four jobs, all required by the ruleset on \`main\`: \`verify\`, \`er-drift\` and
\`service-conventions\`, from the vendored workflow, and \`conventions\`, called from
$FAMILY_REPO at the pinned tag and shown by GitHub as \`conventions / conventions\`.
EOF
sh conventions/conventions-sync sync > /dev/null
cat > CLAUDE.md <<'EOF'
@AGENTS.md
@conventions/WRITING.md
@conventions/WORKING.md
@conventions/REPOSITORIES.md
EOF
cat > .github/workflows/conventions.yml <<EOF
name: conventions
on:
  push:
    branches: [main]
  pull_request:
jobs:
  conventions:
    uses: $FAMILY_REPO/.github/workflows/check.yml@$FAMILY_TAG
EOF

# Then the stack's files, and its block after the family's.
mkdir -p service-conventions
SSRC=${SERVICE_CONVENTIONS_SOURCE:-https://raw.githubusercontent.com/guestgraph/service-conventions/$TAG}
case "$SSRC" in
  http://*|https://*) curl -fsSL "$SSRC/$STACK/service-conventions-sync" -o service-conventions/service-conventions-sync; curl -fsSL "$SSRC/LICENSE" -o LICENSE ;;
  *) cp "$SSRC/$STACK/service-conventions-sync" service-conventions/service-conventions-sync; cp "$SSRC/LICENSE" LICENSE ;;
esac
sh service-conventions/service-conventions-sync sync > /dev/null
VERSION=${TAG#v}

cat > pom.xml <<EOF
